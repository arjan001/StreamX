# API Configuration

# The server origin for logs, app config, and caption keys.
# This is used by packaged builds (APK, Electron) where relative URLs don't work.
# For the CI build, this is overridden by STREAMIX_API_ORIGIN.
PUBLIC_API_ORIGIN=https://dev.lovix.com

