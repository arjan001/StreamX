{
  "name": "Streamix",
  "short_name": "Streamix",
  "description": "A player for the TV sources you add — playlists, Xtream servers and portals. Contains no channels.",
  "id": "/",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#0b1013",
  "theme_color": "#0b1013",
  "categories": [
    "entertainment",
    "video"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
