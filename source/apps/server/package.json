{
  "name": "@iptv/server",
  "version": "1.31.2",
  "private": true,
  "type": "module",
  "description": "The server behind Streamix: logs, app config and live-caption keys — nothing else.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/server.ts",
    "dev": "node --experimental-strip-types --no-warnings --watch src/server.ts",
    "migrate": "node --experimental-strip-types --no-warnings src/db/migrate.ts",
    "test": "node --experimental-strip-types --no-warnings --test 'src/*.test.ts'",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
