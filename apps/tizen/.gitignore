# Build output — regenerated by build.mjs / package.mjs, not checked in.
# (dist/ is also matched by the root .gitignore's generic `dist/` rule;
# staging/ is not, so it's listed here explicitly.)
staging/
dist/

# Store artwork IS checked in — it is an input to a submission, not build output,
# and regenerating it must not be a prerequisite for someone doing the upload.
!store/
