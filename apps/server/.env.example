# Copy to .env and fill in. Nothing here is real.
# The live file is never committed — see .gitignore. docs/SERVER.md explains each line.

# ── database (Postgres 14 or newer) ───────────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=streamix
PGUSER=streamix
PGPASSWORD=
# Or one URL instead of the five above:
# DATABASE_URL=postgres://streamix:password@127.0.0.1:5432/streamix
# PG_POOL_MAX=10

# ── this server ───────────────────────────────────────────────────────────────
PORT=7500
HOST=127.0.0.1
# The public address of the site, e.g. https://streamix.example.com . Allowed by CORS.
PUBLIC_SITE_ORIGIN=
# Extra browser origins that may call the API, comma separated. The app's own
# (capacitor://localhost, http(s)://localhost, file:// builds) are always allowed.
CORS_ORIGINS=
# Which proxy may name the client's address (X-Forwarded-For): an address, a CIDR,
# true or false. Default is loopback. Rate limits depend on this being right.
TRUST_PROXY=127.0.0.1
LOG_LEVEL=info
# pm2 sets these; they let the server cap its own log files.
# LOG_OUT_FILE=
# LOG_ERR_FILE=

# ── the admin area ────────────────────────────────────────────────────────────
# With no password set, the admin area does not exist (and error reports stay off).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── live captions (optional) ──────────────────────────────────────────────────
# The publisher's own Soniox account key. Unset: captions report "unavailable".
SONIOX_API_KEY=
# Soniox keys are region-scoped. Global (default): https://api.soniox.com
# EU keys: https://api.eu.soniox.com
SONIOX_API_BASE=
# Only if the realtime host cannot be derived from SONIOX_API_BASE.
SONIOX_WS_URL=
# SONIOX_MODEL=stt-rt-v5

# ── demo playlist for store reviewers (optional) ──────────────────────────────
# 1 serves /demo/playlist.m3u from the JSON file below. Anything else: off.
DEMO_ENABLED=
# Default: apps/server/demo/streams.json
DEMO_STREAMS_FILE=

# ── where things are (defaults suit a checkout; set them for a split deploy) ──
# The built web app (default apps/web/dist), the root brand.config.json, and the
# shared legal texts (default legal/).
WEB_DIST=
BRAND_CONFIG=
LEGAL_DIR=

# ── website downloads ─────────────────────────────────────────────────────────
# Packages offered on /download. Default apps/server/downloads (gitignored).
# DOWNLOAD_DIR=
